# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://asklineage:asklineage@localhost:5432/asklineage

# none: no LLM; summaries come from a fixed template. Works with zero setup.
# openai_compatible: any server that speaks the OpenAI chat API (Ollama, vLLM, LiteLLM, hosted APIs).
LLM_PROVIDER=none
# Claude instead of Ollama (ADR 0020): LLM_PROVIDER=openai_compatible,
# LLM_BASE_URL=https://api.anthropic.com/v1/, LLM_MODEL=claude-haiku-5-5,
# LLM_RESPONSE_FORMAT=off, LLM_TEMPERATURE=null, and your key in LLM_API_KEY.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
# json_schema (Ollama, vLLM, OpenAI) | json_object | off, for servers that reject the first.
LLM_RESPONSE_FORMAT=json_schema
# 0 for repeatable runs; null leaves it out (newer Claude models reject it).
LLM_TEMPERATURE=0

# Embeddings for semantic search (Phase 2). none: search uses keywords only.
# openai_compatible: any server with the OpenAI embeddings API (Ollama: `ollama pull nomic-embed-text`).
EMBED_PROVIDER=none
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=ollama
EMBED_TIMEOUT_SECONDS=60
# Must match the model's output and the vector column. Changing it means re-embedding.
EMBED_DIMENSIONS=768
EMBED_BATCH_SIZE=32
# Task prefixes. Keep the quotes: the trailing space matters. Use "" for models without prefixes.
EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "

# Search: path patterns of the models users should query (JSON list). A staging model or source
# that matches a question lifts the marts it feeds. [] turns this off.
SEARCH_PREFERRED_PATHS=["models/mart/*", "models/marts/*"]
# Semantic search results whose top score is below this are flagged low confidence.
SEARCH_LOW_CONFIDENCE_BELOW=0.667
# Vector scan: exact (score every chunk), topn (nearest k x overfetch chunks, exact) or hnsw
# (the same through the HNSW index, approximate).
SEARCH_VECTOR_SCAN=topn
SEARCH_OVERFETCH=4
# HNSW's candidate list when SEARCH_VECTOR_SCAN=hnsw; higher is slower and finds more.
SEARCH_HNSW_EF_SEARCH=100
